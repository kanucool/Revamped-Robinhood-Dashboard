{
  "manifest_version": 3,
  "name": "RH Quant Extension",
  "version": "1.0",
  "description": "Custom UI groups and historical JSON extraction.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://robinhood.com/*",
    "https://*.robinhood.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "https://robinhood.com/*",
      "https://*.robinhood.com/*"
    ],
    "js": ["inject.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }, {
    "matches": [
      "https://robinhood.com/*",
      "https://*.robinhood.com/*"
    ],
    "js": [
      "content/state.js",
      "content/tooltip.js",
      "content/styles.js",
      "content/global-ui.js",
      "content/dashboard.js",
      "content/sync-engine.js"
    ],
    "run_at": "document_idle"
  }]
}